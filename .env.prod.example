# Production (compose.prod.yaml). Salin ke .env.prod, isi, JANGAN commit:
#   cp .env.prod.example .env.prod
#   docker compose -f compose.prod.yaml --env-file .env.prod up -d --build
# Semua nilai kosong di bawah wajib diisi; compose berhenti bila ada yang kosong.

POSTGRES_USER=beokay
# Dipakai di URL koneksi -> gunakan karakter URL-safe: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=beokay

API_HOST_PORT=3000
APP_VERSION=0.1.0

# Min. 32 karakter, unik per lingkungan: openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL publik API (https) di belakang reverse proxy.
BETTER_AUTH_URL=https://api.example.com
