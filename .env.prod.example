# Production (compose.prod.yaml). Salin ke .env.prod, isi, JANGAN commit:
#   cp .env.prod.example .env.prod
#   docker compose -f compose.prod.yaml --env-file .env.prod up -d --build
# Semua nilai kosong di bawah yang bertanda WAJIB harus diisi; compose berhenti bila ada yang kosong.

POSTGRES_USER=beokay
# WAJIB. Dipakai di URL koneksi -> gunakan karakter URL-safe: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=beokay

API_HOST_PORT=3000
APP_VERSION=0.1.0

# WAJIB. Min. 32 karakter, unik per lingkungan: openssl rand -base64 32
BETTER_AUTH_SECRET=
# WAJIB. URL publik API (https) di belakang reverse proxy.
BETTER_AUTH_URL=https://api.example.com
# Origin tambahan yang dipercaya, pisahkan dengan koma. Kosong = hanya BETTER_AUTH_URL.
TRUSTED_ORIGINS=
# true bila API di belakang reverse proxy yang MENIMPA X-Forwarded-For. Jika tidak, set false
# (kalau tidak, klien bisa memalsukan IP dan melewati rate limit).
TRUST_PROXY=true

# Pengiriman email (verifikasi dan reset kata sandi). Penyedia apa pun yang mendukung SMTP.
# WAJIB: EMAIL_FROM dan SMTP_HOST.
EMAIL_FROM="beOkay <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
# true untuk port 465 (TLS langsung); false untuk 587 (STARTTLS).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Push (FCM HTTP v1). Kosong = push nonaktif, pengingat tetap jalan sebagai notifikasi lokal di perangkat.
FCM_PROJECT_ID=
# JSON akun layanan Firebase dalam BASE64 (aman untuk shell/compose): base64 -w0 berkas-akun-layanan.json. Rahasia: simpan di secret manager/env prod, jangan di berkas ini.
FCM_SERVICE_ACCOUNT_JSON=
PUSH_DISPATCH_ENABLED=true
# Inferensi model (Modal): URL endpoint https://*.modal.run dan token bearer. Rahasia untuk token; kosong = nonaktif.
MODAL_ML_URL=
MODAL_ML_AUTH_TOKEN=

OUTBOX_WORKER_ENABLED=true
MISTRAL_AGENT_MODEL=
