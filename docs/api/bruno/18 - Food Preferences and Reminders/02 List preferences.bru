meta {
  name: List preferences
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/me/food-preferences
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{sessionToken}}
}

tests {
  test("List preferences", function () {
    expect(res.status).to.equal(200); expect(res.body.items).to.be.an("array");
  });
}

docs {
  Isolated synthetic fixtures only; runtime variables sessionToken and otherSessionToken are supplied by the runner.
  Own preferences only; requires health_data_processing consent.
}
