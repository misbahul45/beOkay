meta {
  name: Import heart rate buckets
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/me/device-import
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{sessionToken}}
  Content-Type: application/json
}

body:json {
  {
    "source": "health_connect",
    "heartRate": [
      { "bucketStart": "{{hrBucketA}}", "bpmMin": 62, "bpmMax": 91, "bpmAvg": 74.5, "sampleCount": 5, "dataOrigin": "com.example.healthsource", "recordingMethod": "automatic", "device": "watch" },
      { "bucketStart": "{{hrBucketB}}", "bpmMin": 64, "bpmMax": 88, "bpmAvg": 73, "sampleCount": 5, "dataOrigin": "com.example.healthsource", "recordingMethod": "automatic", "device": "watch" },
      { "bucketStart": "{{hrBucketC}}", "bpmMin": 70, "bpmMax": 120, "bpmAvg": 95, "sampleCount": 3, "dataOrigin": "com.example.healthsource", "recordingMethod": "automatic", "device": "watch" },
      { "bucketStart": "{{hrBucketA}}", "bpmMin": 5, "bpmMax": 91, "bpmAvg": 74, "sampleCount": 4, "dataOrigin": "com.example.other", "recordingMethod": "automatic" }
    ]
  }
}

script:pre-request {
  const step = 300000;
  const aligned = (minutesAgo) => new Date(Math.floor((Date.now() - minutesAgo * 60000) / step) * step).toISOString();
  bru.setVar("hrBucketA", aligned(90));
  bru.setVar("hrBucketB", aligned(85));
  bru.setVar("hrBucketC", aligned(80));
  bru.setVar("restingAt", aligned(95));
}

tests {
  test("Buckets are created and a technically invalid record is rejected individually", function () {
    expect(res.status).to.equal(200);
    expect(res.body.simulated).to.equal(false);
    expect(res.body.heartRate.created).to.equal(3);
    expect(res.body.heartRate.rejected).to.equal(1);
    expect(res.body.heartRate.results[3].reason).to.equal("HEART_RATE_OUT_OF_DOMAIN");
  });
}

docs {
  Synthetic fixtures. Buckets are 5-minute windows aligned to the UTC epoch; bpm outside 20-300 is rejected per record, unusual values are flagged needsReview.
}
