meta {
  name: Sync checkpoint failure
  type: http
  seq: 10
}

put {
  url: {{baseUrl}}/api/me/device-sync/checkpoints
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{sessionToken}}
  Content-Type: application/json
}

body:json {
  { "metric": "heart_rate", "outcome": "failure", "errorCode": "PERMISSION_REVOKED" }
}

tests {
  test("Failure keeps the last cursor and records the error code", function () {
    expect(res.status).to.equal(200);
    expect(res.body.lastErrorCode).to.equal("PERMISSION_REVOKED");
    expect(res.body.cursor).to.equal("2026-11-14T01:00:00.000Z");
  });
}

docs {
  Isolated synthetic fixtures only; runtime variable sessionToken is supplied by the runner.
}
