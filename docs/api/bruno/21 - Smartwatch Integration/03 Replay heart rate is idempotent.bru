meta {
  name: Replay heart rate is idempotent
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/me/device-import
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{sessionToken}}
  Content-Type: application/json
}

body:json {
  {
    "source": "health_connect",
    "heartRate": [
      { "bucketStart": "{{hrBucketA}}", "bpmMin": 62, "bpmMax": 91, "bpmAvg": 74.5, "sampleCount": 5, "dataOrigin": "com.example.healthsource", "recordingMethod": "automatic", "device": "watch" }
    ]
  }
}

tests {
  test("Replay creates nothing new", function () {
    expect(res.status).to.equal(200);
    expect(res.body.heartRate.created).to.equal(0);
    expect(res.body.heartRate.duplicate).to.equal(1);
  });
}

docs {
  Isolated synthetic fixtures only; runtime variable sessionToken is supplied by the runner.
}
