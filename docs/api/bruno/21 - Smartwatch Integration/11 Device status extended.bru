meta {
  name: Device status extended
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/api/me/devices/status
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{sessionToken}}
}

tests {
  test("Status separates permission, sync state, data freshness and watch verification", function () {
    expect(res.status).to.equal(200);
    expect(res.body).to.have.property("signals");
    expect(res.body).to.have.property("notice");
    expect(res.body.syncState).to.equal("SYNC_FAILED");
    expect(res.body.permissionState).to.equal("PERMISSION_REVOKED");
    expect(res.body.watchVerification).to.equal("WATCH_SOURCE_DETECTED");
    expect(res.body.detectedDeviceTypes).to.include("watch");
    expect(res.body.connectionNotice).to.include("tidak membuktikan");
    expect(res.body.signals.find((s) => s.signal === "heart_rate").observedDays).to.equal(1);
  });
}

docs {
  Isolated synthetic fixtures only; runtime variable sessionToken is supplied by the runner.
}
