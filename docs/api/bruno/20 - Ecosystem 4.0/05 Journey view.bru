meta {
  name: Journey view
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/me/journey
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{sessionToken}}
}

tests {
  test("Prevention capabilities", function () {
    expect(res.status).to.equal(200);
    expect(res.body.journey).to.equal("PREVENTION");
    expect(res.body.capabilities.glucoseFeaturesVisible).to.equal(false);
    expect(res.body.capabilities.screeningReminder).to.equal(true);
  });
}
