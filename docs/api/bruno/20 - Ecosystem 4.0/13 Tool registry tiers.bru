meta {
  name: Tool registry tiers
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/api/me/agent/tools
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{sessionToken}}
}

tests {
  test("All callable tools are READ_ONLY", function () {
    expect(res.status).to.equal(200);
    expect(res.body.items.length).to.equal(11);
    for (const t of res.body.items) expect(t.tier).to.equal("READ_ONLY");
  });
}
