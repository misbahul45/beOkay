meta {
  name: Peers need challenge consent
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/api/me/progress/peers
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{sessionToken}}
}

tests {
  test("403 CONSENT_REQUIRED without challenge_participation", function () {
    expect(res.status).to.equal(403);
    expect(res.body.error.code).to.equal("CONSENT_REQUIRED");
  });
}
