meta {
  name: Memory engine lists
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/api/me/memories
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{sessionToken}}
}

tests {
  test("Active, paused and conflict lists", function () {
    expect(res.status).to.equal(200);
    expect(res.body.items).to.be.an("array");
    expect(res.body.paused).to.be.an("array");
    expect(res.body.conflicts).to.be.an("array");
  });
}
