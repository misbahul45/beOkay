meta {
  name: Revisions
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/api/me/activities/{{activityId}}/revisions
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{sessionToken}}
}

tests {
  test("Revisions", function () {
    expect(res.status).to.equal(200);
    expect(res.body.items[0].snapshot.durationMinutes).to.equal(30);
  });
}

docs {
  Synthetic isolated-test data only. Verified session and health_data_processing consent required.
  Summaries additionally need descriptive_summaries. Owner comes from session; source manual only.
  Stable create UUID and expectedVersion/reason corrections; unknown metrics stay null.
  Inject sessionToken, otherSessionToken, restrictedSessionToken, newActivityId and eventTime at runtime.
  See docs/api/activity.md for contracts, parameters, responses, errors and aggregation rules.
}
