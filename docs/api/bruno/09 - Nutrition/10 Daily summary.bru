meta {
  name: Daily summary
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/api/me/summaries/daily
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{sessionToken}}
}

tests {
  test("Daily summary", function () {
    expect(res.status).to.equal(200);
    expect(res.body.freshness).to.equal("CURRENT"); expect(res.body.mealCount).to.be.greaterThan(0);
  });
}

docs {
  Synthetic isolated-test data only. Verified session and health_data_processing consent required.
  Daily summaries also require descriptive_summaries consent. Server derives owner from the session.
  See docs/api/nutrition.md for schemas, business rules, error codes and examples.
}
