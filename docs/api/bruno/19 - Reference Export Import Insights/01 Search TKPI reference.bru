meta {
  name: Search TKPI reference
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/me/foods/reference?q=tempe
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{sessionToken}}
}

tests {
  test("Search TKPI reference", function () {
    expect(res.status).to.equal(200); expect(res.body.items.every(i => i.verification === "verified_auto")).to.equal(true);
  });
}

docs {
  Isolated synthetic fixtures only; runtime variables sessionToken and otherSessionToken are supplied by the runner.
  Hybrid lexical + semantic (pgvector). Only verified_auto rows; provenance label 'TKPI (OCR, pemeriksaan otomatis)'. verified_auto means internally consistent, not human-verified.
}
