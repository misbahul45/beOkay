meta {
  name: Export my data
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/me/export
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{sessionToken}}
}

tests {
  test("Export my data", function () {
    expect(res.status).to.equal(200); expect(res.body.format).to.equal("beokay-export-v1");
  });
}

docs {
  Isolated synthetic fixtures only; runtime variables sessionToken and otherSessionToken are supplied by the runner.
  Own data only; no sessions, passwords or internal hashes. Works even after consent is withdrawn. 5 per hour.
}
