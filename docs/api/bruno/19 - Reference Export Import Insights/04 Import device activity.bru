meta {
  name: Import device activity
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/me/activities/import
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{sessionToken}}
}

body:json {
  {"source":"health_connect","sessions":[{"externalId":"hc-bruno-1","activityType":"walking","startedAt":"2026-11-09T01:00:00.000Z","durationMinutes":20}]}
}

tests {
  test("Import device activity", function () {
    expect(res.status).to.equal(200); expect(res.body.results).to.be.an("array");
  });
}

docs {
  Isolated synthetic fixtures only; runtime variables sessionToken and otherSessionToken are supplied by the runner.
  Idempotent per (source, externalId). Overlapping sessions become needs_review and are not counted.
}
