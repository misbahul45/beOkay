}

tests {
  test("Discover local only", function () {
    expect(res.status).to.equal(200); expect(res.body.external.status).to.equal("NOT_REQUESTED");
  });
}

docs {
  Isolated synthetic fixtures only; runtime variables sessionToken, otherSessionToken and foodId are supplied by the runner.
  Local-first. No third-party call unless external=true.
}
