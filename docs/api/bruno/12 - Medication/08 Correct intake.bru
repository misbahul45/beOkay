meta {
  name: Correct intake
  type: http
  seq: 8
}

patch {
  url: {{baseUrl}}/api/me/medications/{{regimenId}}/intakes/{{intakeId}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{sessionToken}}
}

body:json {
  {
    "status": "skipped",
    "expectedVersion": 1,
    "reason": "Salah menekan tombol"
  }
}

tests {
  test("Correct intake", function () {
    expect(res.status).to.equal(200); expect(res.body.version).to.equal(2);
  });
}

docs {
  Isolated synthetic fixtures only; runtime variables sessionToken, otherSessionToken and the new*Id values are supplied by the runner.
  Corrections require expectedVersion and reason; revision kept.
}
