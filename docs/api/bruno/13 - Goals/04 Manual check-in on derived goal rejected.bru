meta {
  name: Manual check-in on derived goal rejected
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/me/goals/{{goalId}}/checkins
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{sessionToken}}
}

body:json {
  {
    "id": "{{newCheckinId}}",
    "eventAt": "{{eventTime}}",
    "status": "completed"
  }
}

tests {
  test("Manual check-in on derived goal rejected", function () {
    expect(res.status).to.equal(422);
  });
}

docs {
  Isolated synthetic fixtures only; runtime variables sessionToken, otherSessionToken and the new*Id values are supplied by the runner.
  Manual check-ins are only for manual_checkins goals.
}
