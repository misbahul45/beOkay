<file path="api/bruno/08 - Today Dashboard/Get Today.bru">
meta {
  name: Get Today
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/me/today
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{sessionToken}}
}

tests {
  test("Today returns account context and honest availability", function () {
    expect(res.status).to.equal(200);
    expect(res.body.date).to.match(/^\d{4}-\d{2}-\d{2}$/);
    expect(res.body.timezone).to.be.a("string");
    expect(res.body.analyticsState).to.equal("NOT_AVAILABLE");
    expect(res.body.metrics).to.have.lengthOf(4);
    res.body.metrics.forEach(function (metric) {
      if (metric.domain === "nutrition") {
        expect(metric.availability).to.equal("AVAILABLE");
        expect(metric.value.mealCount).to.be.a("number");
      } else if (metric.domain === "glucose") {
        expect(metric.availability).to.equal("AVAILABLE");
        expect(metric.value.count).to.be.a("number");
        if (metric.value.count === 0) expect(metric.value.latest).to.equal(null);
      } else if (metric.domain === "activity") {
        expect(metric.availability).to.equal("AVAILABLE");
        expect(metric.value.count).to.be.a("number");
      } else {
        expect(metric.value).to.equal(null);
        expect(metric.availability).to.equal("NOT_IMPLEMENTED");
      }
    });
  });
}

docs {
  Requires a verified Better Auth session and current health_data_processing plus descriptive_summaries consent.
  No request body or date/user query parameters. Date and greeting use saved IANA timezone.
  Inject sessionToken at runtime. Never store tokens in the collection.
  401: inactive/missing session. 403 CONSENT_REQUIRED: missing/withdrawn/obsolete policy consent. 500: safe generic failure.
  Nutrition and Glucose metrics are AVAILABLE with real source counts; empty glucose is latest=null. Activity/Medication stay NOT_IMPLEMENTED. Broader Insights analyticsState remains NOT_AVAILABLE.
}
</file>

