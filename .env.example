# Dev (compose.yaml). Semua punya default; salin ke .env hanya bila ingin mengubah:
#   cp .env.example .env
# .env di-ignore git. Jangan menaruh nilai produksi di sini (pakai .env.prod).

# UID/GID pengguna host. Container berjalan dengan ID ini agar tidak membuat berkas milik root.
# Cek dengan: id -u && id -g
HOST_UID=1000
HOST_GID=1000

POSTGRES_USER=beokay
POSTGRES_PASSWORD=beokay_dev_password
POSTGRES_DB=beokay
# Host port Postgres (5432 dipakai proyek lain di mesin ini).
POSTGRES_HOST_PORT=5433
# Host port API. BETTER_AUTH_URL di compose diturunkan dari port ini.
API_HOST_PORT=3000
# UI Mailpit (email dev tertangkap di sini, tidak keluar ke internet).
MAILPIT_UI_PORT=8025
# Origin tambahan yang dipercaya Better Auth, pisahkan dengan koma.
# Kosong = hanya BETTER_AUTH_URL.
TRUSTED_ORIGINS=
# Min. 32 karakter. Buat sendiri: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef

# Mistral: embedding RAG, OCR label, foto makanan, dan teks penjelasan saran. Isi lokal di .env
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_EMBEDDING_MODEL=mistral-embed
# Pemindaian label (OCR) dan foto makanan memakai kunci Mistral yang sama. Kosong = nama bawaan di bawah.
MISTRAL_OCR_MODEL=
MISTRAL_VISION_MODEL=

# Opsional: tanpa kunci ini, pencarian USDA FoodData Central nonaktif (Open Food Facts tidak memerlukan kunci).
USDA_API_KEY=

# UploadThing (penyimpanan berkas). Isi lokal di .env; kosong = unggah nonaktif.
UPLOADTHING_TOKEN=
# Opsional: pencarian web terkontrol untuk penemuan makanan (Tavily Search API). Kosong = nonaktif.
TAVILY_API_KEY=
# Opsional: tanpa kunci ini, tombol "Cari di web" pada draf catatan makan nonaktif. Nama makanan dikirim ke Firecrawl hanya atas permintaan pengguna.
FIRECRAWL_API_KEY=
# Push (FCM HTTP v1). Kosong = push nonaktif, pengingat tetap jalan sebagai notifikasi lokal di perangkat.
FCM_PROJECT_ID=
# JSON akun layanan Firebase dalam BASE64 (aman untuk shell/compose): base64 -w0 berkas-akun-layanan.json. Rahasia: simpan di secret manager/env prod, jangan di berkas ini.
FCM_SERVICE_ACCOUNT_JSON=
PUSH_DISPATCH_ENABLED=true
# Inferensi model (Modal): URL endpoint https://*.modal.run dan token bearer. Rahasia untuk token; kosong = nonaktif.
MODAL_ML_URL=
MODAL_ML_AUTH_TOKEN=

# Pekerja outbox (peristiwa agen/hasil terukur) dan model bahasa penulis teks saran (opsional)
OUTBOX_WORKER_ENABLED=true
MISTRAL_AGENT_MODEL=

# Fase 8: sakelar fitur (kunci dipisah koma: assistant,conversation,coaching,community,ml_inference,food_vision,web_discovery,analytics,push,llm_router,companion,cgm).
# Nilai di tabel feature_flags (scripts/ops/feature-flag.ts) menang atas daftar ini.
FEATURES_DISABLED=
# Surel tujuan laporan masalah/kejadian dari pengguna. Kosong = laporan hanya tersimpan di DB.
INCIDENT_EMAIL_TO=
# Fase 11: tampilkan modul edukasi yang masih draf (belum ditinjau klinisi). Produksi: false sampai ditinjau.
EDUCATION_INCLUDE_DRAFTS=true
# Retensi data (hari). Pekerja berjalan sekali sehari.
RETENTION_WORKER_ENABLED=true
RETENTION_AGENT_EVENTS_DAYS=90
RETENTION_READ_NOTIFICATIONS_DAYS=60
RETENTION_AUDIT_DAYS=365
RETENTION_USAGE_DAYS=400
RETENTION_OUTBOX_DAYS=30

# Deploy serverless (Vercel): pekerja latar diganti /internal/jobs/tick yang dipanggil penjadwal eksternal.
# CRON_SECRET minimal 16 karakter; tanpa nilai, rute jobs membalas 404. Vercel Cron mengirimnya otomatis sebagai Bearer.
CRON_SECRET=
# Jendela tengok-belakang pengingat (menit). Isi >= interval penjadwal + jeda (mis. 12 untuk tick tiap 10 menit).
REMINDER_LOOKBACK_MINUTES=3
# Ukuran pool koneksi Postgres per instance (serverless: 3).
DATABASE_POOL_MAX=10
# Opsional: Redis (rediss://...) untuk meneruskan pesan realtime antar-instance (Upstash Redis gratis).
REALTIME_REDIS_URL=
