# Dev (compose.yaml). Semua punya default; salin ke .env hanya bila ingin mengubah:
#   cp .env.example .env
# .env di-ignore git. Jangan menaruh nilai produksi di sini (pakai .env.prod).

# UID/GID pengguna host. Container berjalan dengan ID ini agar tidak membuat berkas milik root.
# Cek dengan: id -u && id -g
HOST_UID=1000
HOST_GID=1000

POSTGRES_USER=beokay
POSTGRES_PASSWORD=beokay_dev_password
POSTGRES_DB=beokay
# Host port Postgres (5432 dipakai proyek lain di mesin ini).
POSTGRES_HOST_PORT=5433
# Host port API. BETTER_AUTH_URL di compose diturunkan dari port ini.
API_HOST_PORT=3000
# UI Mailpit (email dev tertangkap di sini, tidak keluar ke internet).
MAILPIT_UI_PORT=8025
# Origin tambahan yang dipercaya Better Auth, pisahkan dengan koma.
# Kosong = hanya BETTER_AUTH_URL.
TRUSTED_ORIGINS=
# Min. 32 karakter. Buat sendiri: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef

# LLM dan embedding (dipakai tahap P2/RAG; belum dipakai kode P0/P1). Isi lokal di .env
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIER_BOOT_VALIDATE=
LLM_MODEL_NAME=
LLM_MODEL_FAST=
LLM_MODEL_REASONING=
LLM_MODEL_CRITIC=
LLM_TEMPERATURE=
LLM_MAX_TOKENS=
LLM_TIMEOUT_SEC=
LLM_MAX_RETRIES=
LLM_PRICING_JSON=

# Embedding RAG memakai Mistral (isi lokal di .env; belum dipakai kode P0/P1)
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_EMBEDDING_MODEL=mistral-embed
# Pemindaian label (OCR) dan foto makanan memakai kunci Mistral yang sama. Kosong = nama bawaan di bawah.
MISTRAL_OCR_MODEL=
MISTRAL_VISION_MODEL=

# Opsional: tanpa kunci ini, pencarian USDA FoodData Central nonaktif (Open Food Facts tidak memerlukan kunci).
USDA_API_KEY=

# UploadThing (penyimpanan berkas). Isi lokal di .env; kosong = unggah nonaktif.
UPLOADTHING_TOKEN=
# Opsional: pencarian web terkontrol (Brave Search API). Kosong = nonaktif.
BRAVE_API_KEY=
# Push (FCM HTTP v1). Kosong = push nonaktif, pengingat tetap jalan sebagai notifikasi lokal di perangkat.
FCM_PROJECT_ID=
# JSON akun layanan Firebase dalam BASE64 (aman untuk shell/compose): base64 -w0 berkas-akun-layanan.json. Rahasia: simpan di secret manager/env prod, jangan di berkas ini.
FCM_SERVICE_ACCOUNT_JSON=
PUSH_DISPATCH_ENABLED=true
# Inferensi model (Modal): URL endpoint https://*.modal.run dan token bearer. Rahasia untuk token; kosong = nonaktif.
MODAL_ML_URL=
MODAL_ML_AUTH_TOKEN=

# Pekerja outbox (peristiwa agen/hasil terukur) dan model bahasa penulis teks saran (opsional)
OUTBOX_WORKER_ENABLED=true
MISTRAL_AGENT_MODEL=
