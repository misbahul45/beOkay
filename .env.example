# Dev (compose.yaml). Semua punya default; salin ke .env hanya bila ingin mengubah:
#   cp .env.example .env
# .env di-ignore git. Jangan menaruh nilai produksi di sini (pakai .env.prod).

# UID/GID pengguna host. Container berjalan dengan ID ini agar tidak membuat berkas milik root.
# Cek dengan: id -u && id -g
HOST_UID=1000
HOST_GID=1000

POSTGRES_USER=beokay
POSTGRES_PASSWORD=beokay_dev_password
POSTGRES_DB=beokay
# Host port Postgres (5432 dipakai proyek lain di mesin ini).
POSTGRES_HOST_PORT=5433
# Host port API. BETTER_AUTH_URL di compose diturunkan dari port ini.
API_HOST_PORT=3000
# UI Mailpit (email dev tertangkap di sini, tidak keluar ke internet).
MAILPIT_UI_PORT=8025
# Origin tambahan yang dipercaya Better Auth, pisahkan dengan koma.
# Kosong = hanya BETTER_AUTH_URL.
TRUSTED_ORIGINS=
# Min. 32 karakter. Buat sendiri: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
