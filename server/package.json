{
  "name": "server",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "latest",
    "@types/nodemailer": "^8.0.2",
    "prisma": "7.10.1"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.18",
    "nodemailer": "^10.4.0",
    "uploadthing": "^7.7.4",
    "zod": "^4.6.7"
  },
  "scripts": {
    "dev": "bun --hot index.ts",
    "start": "bun index.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "bun --bun ./node_modules/.bin/prisma generate",
    "db:migrate:dev": "bun --bun ./node_modules/.bin/prisma migrate dev",
    "db:migrate:deploy": "bun --bun ./node_modules/.bin/prisma migrate deploy",
    "db:migrate:diff": "bun --bun ./node_modules/.bin/prisma migrate diff",
    "db:studio": "bun --bun ./node_modules/.bin/prisma studio",
    "auth:generate": "bun --bun x auth@latest generate --config src/lib/auth.ts --adapter prisma -y"
  }
}
