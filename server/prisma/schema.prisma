// beOkay — Prisma schema.
// Model auth di bawah dihasilkan oleh Better Auth CLI (`bun run auth:generate`);
// jangan diedit manual. Model domain P0 menunggu Data Dictionary + Physical ERD
// (lihat blueprint §14).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Users {
  id             String              @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  name           String
  email          String
  emailVerified  Boolean             @default(false)
  image          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  sessionss      Sessions[]
  accountss      Accounts[]
  profile        UserProfile?
  healthProfile  HealthProfile?
  settings       UserSettings?
  onboarding     OnboardingProgress?
  consentRecords ConsentRecord[]
  auditEvents    AuditEvent[]
  foods          FoodCatalog[]
  meals          MealLog[]
  revisions      RecordRevision[]
  glucose        GlucoseObservation[]
  activities     ActivitySession[]
  medications    MedicationRegimen[]
  medicationSchedules MedicationSchedule[]
  medicationIntakes MedicationIntake[]
  goals          BehaviorGoal[]
  goalCheckins   GoalCheckin[]
  syncOperations SyncOperation[]
  summaryProjections SummaryProjection[]
  foodPortionMeasures FoodPortionMeasure[]

  @@unique([email])
  @@map("users")
}

model Sessions {
  id        String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  users     Users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("sessions")
}

model Accounts {
  id                    String    @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  users                 Users     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verifications {
  id         String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

model UserProfile {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  birthYear Int?     @map("birth_year") @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      Users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model HealthProfile {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String   @unique @map("user_id") @db.Uuid
  diagnosisStatus   String   @map("diagnosis_status")
  diabetesType      String?  @map("diabetes_type")
  diagnosedYear     Int?     @map("diagnosed_year") @db.SmallInt
  treatmentContext  String[] @default([]) @map("treatment_context")
  dataSource        String   @default("user_reported") @map("data_source")
  eligibilityStatus String   @default("unknown") @map("eligibility_status")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user              Users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("health_profiles")
}

model UserSettings {
  userId       String   @id @map("user_id") @db.Uuid
  locale       String   @default("id-ID")
  timezone     String   @default("Asia/Jakarta")
  glucoseUnit  String   @default("mg/dL") @map("glucose_unit")
  textSize     String   @default("system") @map("text_size")
  reduceMotion Boolean  @default(false) @map("reduce_motion")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user         Users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model ConsentRecord {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  purpose       String
  policyVersion String    @map("policy_version")
  grantedAt     DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  withdrawnAt   DateTime? @map("withdrawn_at") @db.Timestamptz(6)
  source        String
  user          Users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, grantedAt(sort: Desc)])
  @@map("consent_records")
}

model OnboardingProgress {
  userId      String    @id @map("user_id") @db.Uuid
  introSeenAt DateTime? @map("intro_seen_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  version     Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user        Users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("onboarding_progress")
}

model AuditEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  eventType  String   @map("event_type")
  metadata   Json?    @db.JsonB
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  user       Users?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt(sort: Desc)])
  @@map("audit_events")
}

model FoodCatalog {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String?   @map("user_id") @db.Uuid
  name          String
  source        String
  sourceVersion String?   @map("source_version")
  status        String
  calories      Decimal?  @db.Decimal(12, 4)
  carbohydrates Decimal?  @db.Decimal(12, 4)
  protein       Decimal?  @db.Decimal(12, 4)
  fat           Decimal?  @db.Decimal(12, 4)
  fiber         Decimal?  @db.Decimal(12, 4)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user          Users?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         MealItem[]
  measures      FoodPortionMeasure[]
  @@index([userId, name])
  @@map("food_catalog")
}

model MealLog {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  category    String
  consumedAt  DateTime  @map("consumed_at") @db.Timestamptz(6)
  notes       String?
  captureMethod String  @default("manual") @map("capture_method")
  createHash  String    @map("create_hash")
  version     Int       @default(1)
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user        Users     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       MealItem[]
  revisions   RecordRevision[]
  @@index([userId, consumedAt(sort: Desc), id(sort: Desc)])
  @@map("meal_logs")
}

model MealItem {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mealId        String   @map("meal_id") @db.Uuid
  foodId        String?  @map("food_id") @db.Uuid
  name          String
  quantity      Decimal  @db.Decimal(12, 4)
  unit          String
  grams         Decimal? @db.Decimal(12, 4)
  gramsBasis    String?  @map("grams_basis")
  source        String
  sourceVersion String?  @map("source_version")
  status        String
  calories      Decimal? @db.Decimal(12, 4)
  carbohydrates Decimal? @db.Decimal(12, 4)
  protein       Decimal? @db.Decimal(12, 4)
  fat           Decimal? @db.Decimal(12, 4)
  fiber         Decimal? @db.Decimal(12, 4)
  meal          MealLog  @relation(fields: [mealId], references: [id], onDelete: Cascade)
  food          FoodCatalog? @relation(fields: [foodId], references: [id], onDelete: SetNull)
  @@index([mealId])
  @@index([foodId])
  @@map("meal_items")
}

model RecordRevision {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  mealId      String?  @map("meal_id") @db.Uuid
  glucoseId   String?  @map("glucose_id") @db.Uuid
  activityId  String?  @map("activity_id") @db.Uuid
  regimenId   String?  @map("regimen_id") @db.Uuid
  intakeId    String?  @map("intake_id") @db.Uuid
  goalId      String?  @map("goal_id") @db.Uuid
  checkinId   String?  @map("checkin_id") @db.Uuid
  version     Int
  reason      String
  snapshot    Json     @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user        Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  meal        MealLog? @relation(fields: [mealId], references: [id], onDelete: Cascade)
  glucose     GlucoseObservation? @relation(fields: [glucoseId], references: [id], onDelete: Cascade)
  activity    ActivitySession? @relation(fields: [activityId], references: [id], onDelete: Cascade)
  regimen     MedicationRegimen? @relation(fields: [regimenId], references: [id], onDelete: Cascade)
  intake      MedicationIntake? @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  goal        BehaviorGoal? @relation(fields: [goalId], references: [id], onDelete: Cascade)
  checkin     GoalCheckin? @relation(fields: [checkinId], references: [id], onDelete: Cascade)
  @@unique([mealId, version])
  @@unique([glucoseId, version])
  @@unique([activityId, version])
  @@unique([regimenId, version])
  @@unique([intakeId, version])
  @@unique([goalId, version])
  @@unique([checkinId, version])
  @@index([userId, createdAt(sort: Desc)])
  @@map("record_revisions")
}

model GlucoseObservation {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  source          String   @default("manual_glucometer")
  sourceRecordId  String?  @map("source_record_id")
  measurementType String  @default("capillary_blood") @map("measurement_type")
  valueMgDl       Decimal  @map("value_mg_dl") @db.Decimal(16,7)
  originalValue   Decimal  @map("original_value") @db.Decimal(12,4)
  originalUnit    String   @map("original_unit")
  measuredAt      DateTime @map("measured_at") @db.Timestamptz(6)
  recordedAt      DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)
  receivedAt      DateTime @default(now()) @map("received_at") @db.Timestamptz(6)
  mealContext     String   @default("unknown") @map("meal_context")
  qualityStatus   String   @default("user_reported") @map("quality_status")
  qualityFlags    String[] @default([]) @map("quality_flags")
  notes           String?
  version         Int      @default(1)
  createHash      String   @map("create_hash")
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user            Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  revisions       RecordRevision[]
  @@index([userId, measuredAt(sort: Desc), id(sort: Desc)])
  @@map("glucose_observations")
}

model ActivitySession {
  id                String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String @map("user_id") @db.Uuid
  activityType      String @map("activity_type")
  startedAt         DateTime @map("started_at") @db.Timestamptz(6)
  endedAt           DateTime @map("ended_at") @db.Timestamptz(6)
  durationMinutes   Int @map("duration_minutes")
  distanceKm        Decimal? @map("distance_km") @db.Decimal(10,3)
  steps             Int?
  reportedIntensity String @default("unknown") @map("reported_intensity")
  source            String @default("manual")
  qualityStatus     String @default("user_reported") @map("quality_status")
  notes             String?
  version           Int @default(1)
  createHash        String @map("create_hash")
  archivedAt        DateTime? @map("archived_at") @db.Timestamptz(6)
  recordedAt        DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)
  receivedAt        DateTime @default(now()) @map("received_at") @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user              Users @relation(fields:[userId],references:[id],onDelete:Cascade)
  revisions         RecordRevision[]
  @@index([userId,startedAt(sort:Desc),id(sort:Desc)])
  @@map("activity_sessions")
}

// Self-reported medication list. A schedule is not evidence of intake; unconfirmed occurrences stay unknown.
model MedicationRegimen {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String   @map("user_id") @db.Uuid
  name                String
  strength            String?
  dosageForm          String?  @map("dosage_form")
  dosingInstructions  String?  @map("dosing_instructions")
  instructionSource   String   @default("user_reported") @map("instruction_source")
  startDate           DateTime? @map("start_date") @db.Date
  endDate             DateTime? @map("end_date") @db.Date
  status              String   @default("active")
  version             Int      @default(1)
  createHash          String   @map("create_hash")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedules           MedicationSchedule[]
  intakes             MedicationIntake[]
  revisions           RecordRevision[]
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("medication_regimens")
}

model MedicationSchedule {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  regimenId     String   @map("regimen_id") @db.Uuid
  localTime     String   @map("local_time")
  timezone      String
  daysOfWeek    Int[]    @map("days_of_week")
  enabled       Boolean  @default(true)
  effectiveFrom DateTime @map("effective_from") @db.Date
  disabledAt    DateTime? @map("disabled_at") @db.Timestamptz(6)
  createHash    String   @map("create_hash")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user          Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  regimen       MedicationRegimen @relation(fields: [regimenId], references: [id], onDelete: Cascade)
  intakes       MedicationIntake[]
  @@index([userId, regimenId])
  @@map("medication_schedules")
}

model MedicationIntake {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  regimenId          String   @map("regimen_id") @db.Uuid
  scheduleId         String?  @map("schedule_id") @db.Uuid
  scheduledAt        DateTime? @map("scheduled_at") @db.Timestamptz(6)
  takenAt            DateTime? @map("taken_at") @db.Timestamptz(6)
  eventAt            DateTime @map("event_at") @db.Timestamptz(6)
  status             String
  medicationSnapshot Json     @map("medication_snapshot") @db.JsonB
  notes              String?
  version            Int      @default(1)
  createHash         String   @map("create_hash")
  archivedAt         DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user               Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  regimen            MedicationRegimen @relation(fields: [regimenId], references: [id], onDelete: Cascade)
  schedule           MedicationSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  revisions          RecordRevision[]
  @@index([userId, eventAt(sort: Desc), id(sort: Desc)])
  @@index([regimenId, eventAt(sort: Desc)])
  @@map("medication_intakes")
}

// Behavioral goals only: no goal rewards low glucose values or low calories.
model BehaviorGoal {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  title       String
  goalType    String   @map("goal_type")
  targetValue Decimal  @map("target_value") @db.Decimal(12, 2)
  period      String
  startDate   DateTime @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  status      String   @default("active")
  version     Int      @default(1)
  createHash  String   @map("create_hash")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user        Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkins    GoalCheckin[]
  revisions   RecordRevision[]
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("behavior_goals")
}

model GoalCheckin {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  goalId     String   @map("goal_id") @db.Uuid
  eventAt    DateTime @map("event_at") @db.Timestamptz(6)
  status     String
  value      Decimal  @db.Decimal(12, 2)
  notes      String?
  version    Int      @default(1)
  createHash String   @map("create_hash")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user       Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal       BehaviorGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  revisions  RecordRevision[]
  @@index([userId, goalId, eventAt(sort: Desc), id(sort: Desc)])
  @@map("goal_checkins")
}

model SyncOperation {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  operationId   String   @map("operation_id") @db.Uuid
  payloadHash   String   @map("payload_hash")
  domain        String
  recordId      String   @map("record_id") @db.Uuid
  operationType String   @map("operation_type")
  status        String
  result        Json?
  errorCode     String?  @map("error_code")
  completedAt   DateTime @default(now()) @map("completed_at") @db.Timestamptz(6)
  user          Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, operationId])
  @@index([userId, completedAt(sort: Desc)])
  @@map("sync_operations")
}

model SummaryProjection {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  kind               String
  periodStart        DateTime @map("period_start") @db.Date
  computationVersion String   @map("computation_version")
  coverageStatus     String   @map("coverage_status")
  freshnessStatus    String   @default("CURRENT") @map("freshness_status")
  analyticsState     String   @map("analytics_state")
  metrics            Json
  computedAt         DateTime @map("computed_at") @db.Timestamptz(6)
  user               Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, kind, periodStart, computationVersion])
  @@map("summary_projections")
}

model FoodPortionMeasure {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  foodId    String   @map("food_id") @db.Uuid
  label     String
  grams     Decimal  @db.Decimal(12, 4)
  basis     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  food      FoodCatalog @relation(fields: [foodId], references: [id], onDelete: Cascade)
  @@unique([userId, foodId, label])
  @@index([foodId])
  @@map("food_portion_measures")
}
