// beOkay — Prisma schema.
// Model auth di bawah dihasilkan oleh Better Auth CLI (`bun run auth:generate`);
// jangan diedit manual. Model domain P0 menunggu Data Dictionary + Physical ERD
// (lihat blueprint §14).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Users {
  id             String              @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  name           String
  email          String
  emailVerified  Boolean             @default(false)
  image          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  sessionss      Sessions[]
  accountss      Accounts[]
  profile        UserProfile?
  healthProfile  HealthProfile?
  settings       UserSettings?
  onboarding     OnboardingProgress?
  consentRecords ConsentRecord[]
  auditEvents    AuditEvent[]
  foods          FoodCatalog[]
  meals          MealLog[]
  revisions      RecordRevision[]
  glucose        GlucoseObservation[]
  activities     ActivitySession[]
  medications    MedicationRegimen[]
  medicationSchedules MedicationSchedule[]
  medicationIntakes MedicationIntake[]
  goals          BehaviorGoal[]
  goalCheckins   GoalCheckin[]
  syncOperations SyncOperation[]
  summaryProjections SummaryProjection[]
  foodPortionMeasures FoodPortionMeasure[]
  foodPreferences FoodPreference[]
  reminders Reminder[]
  pushDevices PushDevice[]
  agentRuns AgentRun[]
  communityMemberships CommunityMembership[]
  challengeParticipants ChallengeParticipant[]
  scoreEvents ScoreEvent[]
  challengeCheckins ChallengeCheckin[]
  recommendations Recommendation[]
  plannedMeals PlannedMeal[]
  activityPlans ActivityPlan[]
  outboxEvents OutboxEvent[]
  interventionDecisions InterventionDecision[]
  interventionPreference InterventionPreference?
  recommendationOutcomes RecommendationOutcome[]
  mlInferenceRuns MlInferenceRun[]
  personalization PersonalizationProfile?
  conversationThreads ConversationThread[]
  conversationMessages ConversationMessage[]
  mealDrafts MealDraft[]
  memoryItems MemoryItem[]
  coachingActions CoachingAction[]
  coachingOutcomes CoachingOutcome[]
  coachingEvents CoachingEvent[]
  weeklyCheckins WeeklyCheckin[]

  @@unique([email])
  @@map("users")
}

model Sessions {
  id        String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  users     Users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("sessions")
}

model Accounts {
  id                    String    @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  users                 Users     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verifications {
  id         String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

model UserProfile {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  birthYear Int?     @map("birth_year") @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      Users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model HealthProfile {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String   @unique @map("user_id") @db.Uuid
  diagnosisStatus   String   @map("diagnosis_status")
  diabetesType      String?  @map("diabetes_type")
  diagnosedYear     Int?     @map("diagnosed_year") @db.SmallInt
  treatmentContext  String[] @default([]) @map("treatment_context")
  dataSource        String   @default("user_reported") @map("data_source")
  eligibilityStatus String   @default("unknown") @map("eligibility_status")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user              Users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("health_profiles")
}

model UserSettings {
  userId       String   @id @map("user_id") @db.Uuid
  locale       String   @default("id-ID")
  timezone     String   @default("Asia/Jakarta")
  glucoseUnit  String   @default("mg/dL") @map("glucose_unit")
  textSize     String   @default("system") @map("text_size")
  reduceMotion Boolean  @default(false) @map("reduce_motion")
  memoryEnabled Boolean @default(true) @map("memory_enabled")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user         Users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model ConsentRecord {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  purpose       String
  policyVersion String    @map("policy_version")
  grantedAt     DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  withdrawnAt   DateTime? @map("withdrawn_at") @db.Timestamptz(6)
  source        String
  user          Users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, grantedAt(sort: Desc)])
  @@map("consent_records")
}

model OnboardingProgress {
  userId      String    @id @map("user_id") @db.Uuid
  introSeenAt DateTime? @map("intro_seen_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  version     Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user        Users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("onboarding_progress")
}

model AuditEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  eventType  String   @map("event_type")
  metadata   Json?    @db.JsonB
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  user       Users?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt(sort: Desc)])
  @@map("audit_events")
}

model FoodCatalog {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String?   @map("user_id") @db.Uuid
  name          String
  source        String
  sourceVersion String?   @map("source_version")
  status        String
  calories      Decimal?  @db.Decimal(12, 4)
  carbohydrates Decimal?  @db.Decimal(12, 4)
  protein       Decimal?  @db.Decimal(12, 4)
  fat           Decimal?  @db.Decimal(12, 4)
  fiber         Decimal?  @db.Decimal(12, 4)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user          Users?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         MealItem[]
  measures      FoodPortionMeasure[]
  @@index([userId, name])
  @@map("food_catalog")
}

model MealLog {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  category    String
  consumedAt  DateTime  @map("consumed_at") @db.Timestamptz(6)
  notes       String?
  captureMethod String  @default("manual") @map("capture_method")
  createHash  String    @map("create_hash")
  version     Int       @default(1)
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user        Users     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       MealItem[]
  revisions   RecordRevision[]
  draft       MealDraft?
  @@index([userId, consumedAt(sort: Desc), id(sort: Desc)])
  @@map("meal_logs")
}

model MealItem {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mealId        String   @map("meal_id") @db.Uuid
  foodId        String?  @map("food_id") @db.Uuid
  name          String
  quantity      Decimal  @db.Decimal(12, 4)
  unit          String
  grams         Decimal? @db.Decimal(12, 4)
  gramsBasis    String?  @map("grams_basis")
  source        String
  sourceVersion String?  @map("source_version")
  status        String
  calories      Decimal? @db.Decimal(12, 4)
  carbohydrates Decimal? @db.Decimal(12, 4)
  protein       Decimal? @db.Decimal(12, 4)
  fat           Decimal? @db.Decimal(12, 4)
  fiber         Decimal? @db.Decimal(12, 4)
  meal          MealLog  @relation(fields: [mealId], references: [id], onDelete: Cascade)
  food          FoodCatalog? @relation(fields: [foodId], references: [id], onDelete: SetNull)
  @@index([mealId])
  @@index([foodId])
  @@map("meal_items")
}

model RecordRevision {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  mealId      String?  @map("meal_id") @db.Uuid
  glucoseId   String?  @map("glucose_id") @db.Uuid
  activityId  String?  @map("activity_id") @db.Uuid
  regimenId   String?  @map("regimen_id") @db.Uuid
  intakeId    String?  @map("intake_id") @db.Uuid
  goalId      String?  @map("goal_id") @db.Uuid
  checkinId   String?  @map("checkin_id") @db.Uuid
  version     Int
  reason      String
  snapshot    Json     @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user        Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  meal        MealLog? @relation(fields: [mealId], references: [id], onDelete: Cascade)
  glucose     GlucoseObservation? @relation(fields: [glucoseId], references: [id], onDelete: Cascade)
  activity    ActivitySession? @relation(fields: [activityId], references: [id], onDelete: Cascade)
  regimen     MedicationRegimen? @relation(fields: [regimenId], references: [id], onDelete: Cascade)
  intake      MedicationIntake? @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  goal        BehaviorGoal? @relation(fields: [goalId], references: [id], onDelete: Cascade)
  checkin     GoalCheckin? @relation(fields: [checkinId], references: [id], onDelete: Cascade)
  @@unique([mealId, version])
  @@unique([glucoseId, version])
  @@unique([activityId, version])
  @@unique([regimenId, version])
  @@unique([intakeId, version])
  @@unique([goalId, version])
  @@unique([checkinId, version])
  @@index([userId, createdAt(sort: Desc)])
  @@map("record_revisions")
}

model GlucoseObservation {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  source          String   @default("manual_glucometer")
  sourceRecordId  String?  @map("source_record_id")
  measurementType String  @default("capillary_blood") @map("measurement_type")
  valueMgDl       Decimal  @map("value_mg_dl") @db.Decimal(16,7)
  originalValue   Decimal  @map("original_value") @db.Decimal(12,4)
  originalUnit    String   @map("original_unit")
  measuredAt      DateTime @map("measured_at") @db.Timestamptz(6)
  recordedAt      DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)
  receivedAt      DateTime @default(now()) @map("received_at") @db.Timestamptz(6)
  mealContext     String   @default("unknown") @map("meal_context")
  qualityStatus   String   @default("user_reported") @map("quality_status")
  qualityFlags    String[] @default([]) @map("quality_flags")
  notes           String?
  version         Int      @default(1)
  createHash      String   @map("create_hash")
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user            Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  revisions       RecordRevision[]
  @@index([userId, measuredAt(sort: Desc), id(sort: Desc)])
  @@map("glucose_observations")
}

model ActivitySession {
  id                String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String @map("user_id") @db.Uuid
  activityType      String @map("activity_type")
  startedAt         DateTime @map("started_at") @db.Timestamptz(6)
  endedAt           DateTime @map("ended_at") @db.Timestamptz(6)
  durationMinutes   Int @map("duration_minutes")
  distanceKm        Decimal? @map("distance_km") @db.Decimal(10,3)
  steps             Int?
  reportedIntensity String @default("unknown") @map("reported_intensity")
  source            String @default("manual")
  qualityStatus     String @default("user_reported") @map("quality_status")
  notes             String?
  externalId        String? @map("external_id")
  version           Int @default(1)
  createHash        String @map("create_hash")
  archivedAt        DateTime? @map("archived_at") @db.Timestamptz(6)
  recordedAt        DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)
  receivedAt        DateTime @default(now()) @map("received_at") @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user              Users @relation(fields:[userId],references:[id],onDelete:Cascade)
  revisions         RecordRevision[]
  @@unique([userId, source, externalId])
  @@index([userId,startedAt(sort:Desc),id(sort:Desc)])
  @@map("activity_sessions")
}

// Self-reported medication list. A schedule is not evidence of intake; unconfirmed occurrences stay unknown.
model MedicationRegimen {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String   @map("user_id") @db.Uuid
  name                String
  strength            String?
  dosageForm          String?  @map("dosage_form")
  dosingInstructions  String?  @map("dosing_instructions")
  instructionSource   String   @default("user_reported") @map("instruction_source")
  startDate           DateTime? @map("start_date") @db.Date
  endDate             DateTime? @map("end_date") @db.Date
  status              String   @default("active")
  version             Int      @default(1)
  createHash          String   @map("create_hash")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedules           MedicationSchedule[]
  intakes             MedicationIntake[]
  revisions           RecordRevision[]
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("medication_regimens")
}

model MedicationSchedule {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  regimenId     String   @map("regimen_id") @db.Uuid
  localTime     String   @map("local_time")
  timezone      String
  daysOfWeek    Int[]    @map("days_of_week")
  enabled       Boolean  @default(true)
  effectiveFrom DateTime @map("effective_from") @db.Date
  disabledAt    DateTime? @map("disabled_at") @db.Timestamptz(6)
  createHash    String   @map("create_hash")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user          Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  regimen       MedicationRegimen @relation(fields: [regimenId], references: [id], onDelete: Cascade)
  intakes       MedicationIntake[]
  @@index([userId, regimenId])
  @@map("medication_schedules")
}

model MedicationIntake {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  regimenId          String   @map("regimen_id") @db.Uuid
  scheduleId         String?  @map("schedule_id") @db.Uuid
  scheduledAt        DateTime? @map("scheduled_at") @db.Timestamptz(6)
  takenAt            DateTime? @map("taken_at") @db.Timestamptz(6)
  eventAt            DateTime @map("event_at") @db.Timestamptz(6)
  status             String
  medicationSnapshot Json     @map("medication_snapshot") @db.JsonB
  notes              String?
  version            Int      @default(1)
  createHash         String   @map("create_hash")
  archivedAt         DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user               Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  regimen            MedicationRegimen @relation(fields: [regimenId], references: [id], onDelete: Cascade)
  schedule           MedicationSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  revisions          RecordRevision[]
  @@index([userId, eventAt(sort: Desc), id(sort: Desc)])
  @@index([regimenId, eventAt(sort: Desc)])
  @@map("medication_intakes")
}

// Behavioral goals only: no goal rewards low glucose values or low calories.
model BehaviorGoal {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  title       String
  goalType    String   @map("goal_type")
  targetValue Decimal  @map("target_value") @db.Decimal(12, 2)
  period      String
  startDate   DateTime @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  status      String   @default("active")
  version     Int      @default(1)
  createHash  String   @map("create_hash")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user        Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkins    GoalCheckin[]
  revisions   RecordRevision[]
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("behavior_goals")
}

model GoalCheckin {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  goalId     String   @map("goal_id") @db.Uuid
  eventAt    DateTime @map("event_at") @db.Timestamptz(6)
  status     String
  value      Decimal  @db.Decimal(12, 2)
  notes      String?
  version    Int      @default(1)
  createHash String   @map("create_hash")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user       Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal       BehaviorGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  revisions  RecordRevision[]
  @@index([userId, goalId, eventAt(sort: Desc), id(sort: Desc)])
  @@map("goal_checkins")
}

model SyncOperation {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  operationId   String   @map("operation_id") @db.Uuid
  payloadHash   String   @map("payload_hash")
  domain        String
  recordId      String   @map("record_id") @db.Uuid
  operationType String   @map("operation_type")
  status        String
  result        Json?
  errorCode     String?  @map("error_code")
  completedAt   DateTime @default(now()) @map("completed_at") @db.Timestamptz(6)
  user          Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, operationId])
  @@index([userId, completedAt(sort: Desc)])
  @@map("sync_operations")
}

model SummaryProjection {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  kind               String
  periodStart        DateTime @map("period_start") @db.Date
  computationVersion String   @map("computation_version")
  coverageStatus     String   @map("coverage_status")
  freshnessStatus    String   @default("CURRENT") @map("freshness_status")
  analyticsState     String   @map("analytics_state")
  metrics            Json
  computedAt         DateTime @map("computed_at") @db.Timestamptz(6)
  user               Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, kind, periodStart, computationVersion])
  @@map("summary_projections")
}

model FoodPortionMeasure {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  foodId    String   @map("food_id") @db.Uuid
  label     String
  grams     Decimal  @db.Decimal(12, 4)
  basis     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  food      FoodCatalog @relation(fields: [foodId], references: [id], onDelete: Cascade)
  @@unique([userId, foodId, label])
  @@index([foodId])
  @@map("food_portion_measures")
}

model FoodPreference {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  kind       String
  term       String
  label      String
  severity   String
  notes      String?
  version    Int       @default(1)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user       Users     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, kind, term])
  @@index([userId, archivedAt])
  @@map("food_preferences")
}

model Reminder {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  kind       String
  title      String
  localTime  String    @map("local_time")
  daysOfWeek Int[]     @map("days_of_week") @db.SmallInt
  enabled    Boolean   @default(true)
  version    Int       @default(1)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user       Users     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries PushDelivery[]
  coachingActions CoachingAction[]
  @@index([userId, archivedAt])
  @@map("reminders")
}

/// Referensi komposisi pangan (TKPI). Kolom `embedding` bertipe pgvector diakses lewat SQL mentah.
model FoodReference {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code           String   @unique
  name           String
  nameNormalized String   @map("name_normalized")
  source         String
  sourceVersion  String   @map("source_version")
  sourceRef      String?  @map("source_ref")
  page           Int?
  chapter        String?
  status         String
  flags          String[] @default([])
  water          Decimal? @db.Decimal(12, 4)
  calories       Decimal? @db.Decimal(12, 4)
  protein        Decimal? @db.Decimal(12, 4)
  fat            Decimal? @db.Decimal(12, 4)
  carbohydrates  Decimal? @db.Decimal(12, 4)
  fiber          Decimal? @db.Decimal(12, 4)
  ash            Decimal? @db.Decimal(12, 4)
  embedding      Unsupported("vector(1024)")?
  embeddingModel String?  @map("embedding_model")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  @@index([status])
  @@index([nameNormalized(ops: raw("gin_trgm_ops"))], map: "food_reference_name_trgm_idx", type: Gin)
  @@map("food_reference")
}

model PushDevice {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  token      String   @unique
  platform   String
  appVersion String?  @map("app_version")
  active     Boolean  @default(true)
  lastError  String?  @map("last_error")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user       Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries PushDelivery[]
  @@index([userId, active])
  @@map("push_devices")
}

model PushDelivery {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  reminderId        String   @map("reminder_id") @db.Uuid
  deviceId          String   @map("device_id") @db.Uuid
  scheduledAt       DateTime @map("scheduled_at") @db.Timestamptz(6)
  status            String
  providerMessageId String?  @map("provider_message_id")
  errorCode         String?  @map("error_code")
  attemptedAt       DateTime @default(now()) @map("attempted_at") @db.Timestamptz(6)
  reminder          Reminder   @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  device            PushDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  @@unique([reminderId, deviceId, scheduledAt])
  @@index([userId, attemptedAt])
  @@map("push_deliveries")
}

model AgentRun {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  status         String
  intent         String
  inputText      String   @map("input_text")
  idempotencyKey String   @map("idempotency_key")
  state          Json     @default("{}")
  safetyDecision String?  @map("safety_decision")
  toolCallsUsed  Int      @default(0) @map("tool_calls_used")
  version        Int      @default(1)
  parentRunId    String?  @map("parent_run_id") @db.Uuid
  turn           Int      @default(1)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user           Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent         AgentRun? @relation("RunTurns", fields: [parentRunId], references: [id], onDelete: SetNull)
  followUps      AgentRun[] @relation("RunTurns")
  events         AgentRunEvent[]
  toolCalls      AgentToolCall[]
  recommendations Recommendation[]
  conversationThreads ConversationThread[]
  conversationMessages ConversationMessage[]
  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt(sort: Desc)])
  @@index([parentRunId])
  @@map("agent_runs")
}

model AgentRunEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId     String   @map("run_id") @db.Uuid
  seq       Int
  type      String
  payload   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  run       AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  @@unique([runId, seq])
  @@map("agent_run_events")
}

model AgentToolCall {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId      String   @map("run_id") @db.Uuid
  tool       String
  toolVersion String  @map("tool_version")
  argsHash   String   @map("args_hash")
  status     String
  errorCode  String?  @map("error_code")
  durationMs Int      @map("duration_ms")
  resultSize Int      @default(0) @map("result_size")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  run        AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  @@index([runId])
  @@map("agent_tool_calls")
}

model Recommendation {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  runId         String   @map("run_id") @db.Uuid
  recType       String   @map("rec_type")
  status        String
  version       Int      @default(1)
  payload       Json
  policyVersion String   @map("policy_version")
  expiresAt     DateTime @map("expires_at") @db.Timestamptz(6)
  decidedAt     DateTime? @map("decided_at") @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user          Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  run           AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  decisions     RecommendationDecision[]
  feedback      RecommendationFeedback[]
  plannedMeal   PlannedMeal?
  outcome       RecommendationOutcome?
  activityPlan  ActivityPlan?
  @@index([userId, createdAt(sort: Desc)])
  @@index([runId])
  @@map("recommendations")
}

/// Kuitansi idempotensi untuk keputusan pengguna: satu operationId = satu efek.
model RecommendationDecision {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  recommendationId String   @map("recommendation_id") @db.Uuid
  operationId      String   @map("operation_id") @db.Uuid
  decision         String
  resultVersion    Int      @map("result_version")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  @@unique([userId, operationId])
  @@map("recommendation_decisions")
}

model RecommendationFeedback {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  recommendationId String   @map("recommendation_id") @db.Uuid
  operationId      String   @map("operation_id") @db.Uuid
  kind             String
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  @@unique([userId, operationId])
  @@index([recommendationId])
  @@map("recommendation_feedback")
}

/// Rencana makan. BUKAN catatan konsumsi (meal_logs): rencana tidak pernah menjadi konsumsi otomatis.
model PlannedMeal {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  recommendationId String   @unique @map("recommendation_id") @db.Uuid
  name             String
  source           String
  sourceRef        String?  @map("source_ref")
  per100g          Json
  status           String
  version          Int      @default(1)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user             Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt(sort: Desc)])
  @@map("planned_meals")
}

model PersonalizationProfile {
  userId    String   @id @map("user_id") @db.Uuid
  version   Int      @default(0)
  data      Json     @default("{}")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  events    PersonalizationEvent[]
  @@map("personalization_profiles")
}

model PersonalizationEvent {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                 String   @map("user_id") @db.Uuid
  version                Int
  reason                 String
  sourceRecommendationId String?  @map("source_recommendation_id") @db.Uuid
  change                 Json
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  profile                PersonalizationProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)
  @@unique([userId, version])
  @@map("personalization_events")
}

model Region {
  code        String      @id
  name        String
  level       String      @default("PROVINCE")
  communities Community[]
  @@map("regions")
}

model Community {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  regionCode  String   @map("region_code")
  name        String
  description String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  region      Region   @relation(fields: [regionCode], references: [code])
  memberships CommunityMembership[]
  challenges  Challenge[]
  @@index([regionCode])
  @@map("communities")
}

/// Identitas publik komunitas = alias. Tidak ada FK ke profil/ukuran kesehatan.
model CommunityMembership {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  communityId String    @map("community_id") @db.Uuid
  alias       String
  aliasKey    String    @map("alias_key")
  status      String
  joinedAt    DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)
  leftAt      DateTime? @map("left_at") @db.Timestamptz(6)
  user        Users     @relation(fields: [userId], references: [id], onDelete: Cascade)
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  @@unique([userId, communityId])
  @@index([communityId, status])
  @@map("community_memberships")
}

model Challenge {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  communityId   String   @map("community_id") @db.Uuid
  title         String
  description   String
  kind          String
  startsOn      DateTime @map("starts_on") @db.Date
  endsOn        DateTime @map("ends_on") @db.Date
  targetDays    Int      @map("target_days")
  scoringVersion String  @map("scoring_version")
  status        String
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  community     Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  participants  ChallengeParticipant[]
  scoreEvents   ScoreEvent[]
  checkins      ChallengeCheckin[]
  @@index([communityId, status])
  @@map("challenges")
}

model ChallengeParticipant {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  challengeId       String    @map("challenge_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  leaderboardVisible Boolean  @default(false) @map("leaderboard_visible")
  joinedAt          DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)
  leftAt            DateTime? @map("left_at") @db.Timestamptz(6)
  challenge         Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user              Users     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([challengeId, userId])
  @@map("challenge_participants")
}

model ChallengeCheckin {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  challengeId String   @map("challenge_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  localDate   DateTime @map("local_date") @db.Date
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user        Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([challengeId, userId, localDate])
  @@map("challenge_checkins")
}

/// Buku besar skor append-only. Koreksi = baris pembalikan baru (reversal_of), bukan penghapusan.
model ScoreEvent {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  challengeId    String   @map("challenge_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  eventType      String   @map("event_type")
  sourceKey      String   @map("source_key")
  localDate      DateTime? @map("local_date") @db.Date
  points         Decimal  @db.Decimal(10, 4)
  scoringVersion String   @map("scoring_version")
  reason         String
  reversalOf     String?  @unique @map("reversal_of") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  challenge      Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user           Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([challengeId, userId])
  @@map("score_events")
}

/// Rencana aktivitas. BUKAN catatan aktivitas (activity_sessions): rencana tidak pernah menjadi sesi otomatis.
model ActivityPlan {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  recommendationId String   @unique @map("recommendation_id") @db.Uuid
  activityType     String   @map("activity_type")
  durationMinutes  Int      @map("duration_minutes")
  plannedFor       DateTime @map("planned_for") @db.Date
  status           String
  linkedSessionId  String?  @map("linked_session_id") @db.Uuid
  version          Int      @default(1)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user             Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt(sort: Desc)])
  @@map("activity_plans")
}

model ModelVersion {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  modelKey              String   @map("model_key")
  version               String
  artifactSha256        String   @map("artifact_sha256")
  featureSchemaVersion  String   @map("feature_schema_version")
  status                String
  intendedUse           String   @map("intended_use")
  trainingDataProvenance String  @map("training_data_provenance")
  evaluation            Json
  endpointRef           String   @map("endpoint_ref")
  approvedAt            DateTime? @map("approved_at") @db.Timestamptz(6)
  approvalNote          String?  @map("approval_note")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  runs                  MlInferenceRun[]
  @@unique([modelKey, version])
  @@map("model_versions")
}

/// Audit inferensi. Tidak menyimpan gambar maupun identitas selain user_id (hapus akun = SET NULL).
model MlInferenceRun {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  modelVersionId String   @map("model_version_id") @db.Uuid
  mode           String
  status         String
  latencyMs      Int      @map("latency_ms")
  inputBytes     Int      @map("input_bytes")
  topLabel       String?  @map("top_label")
  topProbability Decimal? @map("top_probability") @db.Decimal(5, 4)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user           Users?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  model          ModelVersion @relation(fields: [modelVersionId], references: [id], onDelete: Restrict)
  @@index([modelVersionId, createdAt(sort: Desc)])
  @@map("ml_inference_runs")
}

/// Outbox transaksional: peristiwa ditulis dalam transaksi yang sama dengan perubahan data, lalu diproses pekerja dengan retry.
model OutboxEvent {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String?   @map("user_id") @db.Uuid
  type        String
  payload     Json      @default("{}")
  dedupeKey   String    @unique @map("dedupe_key")
  status      String    @default("PENDING")
  attempts    Int       @default(0)
  availableAt DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)
  lastError   String?   @map("last_error")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user        Users?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([status, availableAt])
  @@map("outbox_events")
}

/// Hasil TERUKUR dari catatan nyata pengguna (catatan makan/sesi aktivitas) untuk rencana yang diterima. Berbeda dari umpan balik yang dilaporkan sendiri.
model RecommendationOutcome {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  recommendationId String   @unique @map("recommendation_id") @db.Uuid
  kind             String
  evidenceType     String   @map("evidence_type")
  evidenceId       String   @map("evidence_id") @db.Uuid
  observedAt       DateTime @map("observed_at") @db.Timestamptz(6)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user             Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  @@index([userId, observedAt(sort: Desc)])
  @@map("recommendation_outcomes")
}

/// Pengaturan intervensi proaktif pengguna: jeda, jam tenang, jatah, dan jenis yang dimatikan. Angka awal adalah hipotesis produk, bukan batas klinis.
model InterventionPreference {
  userId           String   @id @map("user_id") @db.Uuid
  pausedUntil      DateTime? @map("paused_until") @db.Timestamptz(6)
  quietStartMinute Int      @default(1320) @map("quiet_start_minute")
  quietEndMinute   Int      @default(420) @map("quiet_end_minute")
  maxPerDay        Int      @default(2) @map("max_per_day")
  maxPerWeek       Int      @default(7) @map("max_per_week")
  mutedTriggers    String[] @default([]) @map("muted_triggers")
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user             Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("intervention_preferences")
}

/// Setiap keputusan (termasuk "tidak mengintervensi") dicatat dengan alasan. Tidak menyimpan nilai klinis mentah.
model InterventionDecision {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  triggerType      String   @map("trigger_type")
  subjectRef       String?  @map("subject_ref")
  decidedAt        DateTime @default(now()) @map("decided_at") @db.Timestamptz(6)
  localDate        String   @map("local_date")
  timezone         String
  policyVersion    String   @map("policy_version")
  eligibilityStatus String  @map("eligibility_status")
  dataCoverage     String   @map("data_coverage")
  option           String
  reason           String?
  approvalStatus   String   @map("approval_status")
  deliveryStatus   String   @map("delivery_status")
  content          Json?
  dedupeKey        String?  @unique @map("dedupe_key")
  expiresAt        DateTime? @map("expires_at") @db.Timestamptz(6)
  snoozedUntil     DateTime? @map("snoozed_until") @db.Timestamptz(6)
  response         String?
  respondedAt      DateTime? @map("responded_at") @db.Timestamptz(6)
  user             Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, decidedAt(sort: Desc)])
  @@index([userId, deliveryStatus])
  @@map("intervention_decisions")
}

model ConversationThread {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  title         String?
  lastRunId     String?   @map("last_run_id") @db.Uuid
  messageCount  Int       @default(0) @map("message_count")
  lastMessageAt DateTime? @map("last_message_at") @db.Timestamptz(6)
  context       Json      @default("{}")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user          Users     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastRun       AgentRun? @relation(fields: [lastRunId], references: [id], onDelete: SetNull)
  messages      ConversationMessage[]
  mealDrafts    MealDraft[]
  @@index([userId, lastMessageAt(sort: Desc)])
  @@index([lastRunId])
  @@map("conversation_threads")
}

model ConversationMessage {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  threadId        String               @map("thread_id") @db.Uuid
  userId          String               @map("user_id") @db.Uuid
  seq             Int
  role            String
  clientMessageId String?              @map("client_message_id") @db.Uuid
  replyToId       String?              @unique @map("reply_to_id") @db.Uuid
  text            String?
  parts           Json                 @default("[]")
  route           String?
  routerVersion   String?              @map("router_version")
  basis           Json?
  runId           String?              @map("run_id") @db.Uuid
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  thread          ConversationThread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user            Users                @relation(fields: [userId], references: [id], onDelete: Cascade)
  replyTo         ConversationMessage? @relation("MessageReply", fields: [replyToId], references: [id], onDelete: Cascade)
  reply           ConversationMessage? @relation("MessageReply")
  run             AgentRun?            @relation(fields: [runId], references: [id], onDelete: SetNull)
  @@unique([userId, clientMessageId])
  @@unique([threadId, seq])
  @@index([runId])
  @@map("conversation_messages")
}

model MealDraft {
  id         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String              @map("user_id") @db.Uuid
  threadId   String?             @map("thread_id") @db.Uuid
  source     String
  status     String              @default("PROPOSED")
  category   String
  consumedAt DateTime            @map("consumed_at") @db.Timestamptz(6)
  inputText  String?             @map("input_text")
  items      Json                @default("[]")
  mealId     String?             @unique @map("meal_id") @db.Uuid
  version    Int                 @default(1)
  expiresAt  DateTime            @map("expires_at") @db.Timestamptz(6)
  resolvedAt DateTime?           @map("resolved_at") @db.Timestamptz(6)
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  user       Users               @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread     ConversationThread? @relation(fields: [threadId], references: [id], onDelete: SetNull)
  meal       MealLog?            @relation(fields: [mealId], references: [id], onDelete: SetNull)
  @@index([userId, createdAt(sort: Desc)])
  @@index([threadId])
  @@map("meal_drafts")
}

model MemoryItem {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  category    String
  kind        String
  key         String
  content     String
  status      String    @default("PROPOSED")
  sourceType  String    @map("source_type")
  sourceId    String?   @map("source_id") @db.Uuid
  confidence  String    @default("STATED")
  sensitivity String    @default("LOW")
  retention   String    @default("UNTIL_DELETED")
  version     Int       @default(1)
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user        Users     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, status])
  @@map("memory_items")
}

/// Rencana kecil dari peluang yang didukung catatan. Usulan (PROPOSED) baru menjadi rencana setelah diterima pengguna; status per hari ada di coaching_outcomes.
model CoachingAction {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  opportunityKey String    @map("opportunity_key")
  source         String
  kind           String
  title          String
  rationale      String
  evidence       Json
  params         Json
  slot           String?
  startDate      DateTime  @map("start_date") @db.Date
  days           Int
  status         String    @default("PROPOSED")
  closeReason    String?   @map("close_reason")
  reminderId     String?   @map("reminder_id") @db.Uuid
  policyVersion  String    @map("policy_version")
  version        Int       @default(1)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  decidedAt      DateTime? @map("decided_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user           Users     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminder       Reminder? @relation(fields: [reminderId], references: [id], onDelete: SetNull)
  outcomes       CoachingOutcome[]
  events         CoachingEvent[]
  @@index([userId, status, createdAt(sort: Desc)])
  @@map("coaching_actions")
}

/// Bukti per hari untuk rencana yang diterima: tercatat (OBSERVED), dikonfirmasi sendiri (USER_CONFIRMED), atau bukti ditarik (RETRACTED). Hari tanpa baris = belum terlihat, bukan gagal.
model CoachingOutcome {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  actionId     String    @map("action_id") @db.Uuid
  localDate    DateTime  @map("local_date") @db.Date
  status       String
  evidenceType String?   @map("evidence_type")
  evidenceId   String?   @map("evidence_id") @db.Uuid
  observedAt   DateTime? @map("observed_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user         Users     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action       CoachingAction @relation(fields: [actionId], references: [id], onDelete: Cascade)
  @@unique([actionId, localDate])
  @@index([userId, localDate])
  @@map("coaching_outcomes")
}

/// Kuitansi idempotensi dan jejak audit keputusan, umpan balik, dan konfirmasi: satu operationId = satu efek.
model CoachingEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  actionId    String?  @map("action_id") @db.Uuid
  operationId String   @map("operation_id") @db.Uuid
  type        String
  value       String
  detail      Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user        Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  action      CoachingAction? @relation(fields: [actionId], references: [id], onDelete: Cascade)
  @@unique([userId, operationId])
  @@index([actionId])
  @@map("coaching_events")
}

/// Refleksi mingguan: satu per minggu. Menyimpan jawaban pengguna dan penyesuaian yang ia setujui; ringkasan hanya angka deskriptif tanpa nilai klinis.
model WeeklyCheckin {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  weekStart     DateTime @map("week_start") @db.Date
  operationId   String   @map("operation_id") @db.Uuid
  mood          String?
  hardest       String[] @default([])
  note          String?
  preferredSlot String?  @map("preferred_slot")
  adjustments   Json     @default("[]")
  summary       Json
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user          Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, weekStart])
  @@unique([userId, operationId])
  @@map("weekly_checkins")
}
